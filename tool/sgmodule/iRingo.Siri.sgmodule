#!name= iRingo: ⭕ Siri
#!desc=iOS 18⬆️ &amp; macOS 15⬆️\n全面自定义「Siri 请求」功能。\n⚠️ 不含自定义「Siri 建议」功能。
#!author=VirgilClyne[https://github.com/VirgilClyne]
#!icon=https://developer.apple.com/assets/elements/icons/siri/siri-128x128.png
#!openUrl=http://boxjs.com/#/app/iRingo.Siri
#!homepage=https://NSRingo.github.io/guide/Siri/siri
#!category= iRingo
#!system=iOS,iPadOS,macOS
#!date=2024-12-24 04:25:06
#!version=4.2.7
#!system_version=15
#!arguments=CountryCode:"US",SiriLocale:"zh_CN",Region:"OFF",SiriResponseLanguageVariant:"zh_CN",LogLevel:"WARN"
#!arguments-desc=CountryCode: 国家或地区代码\n不同国家或地区提供的内容或有差别，此选项同时会影响分配给您不同地区的 Siri 服务器。\n可选值: US, OFF, AUTO, CN, HK, TW, SG, JP, AU, GB, KR, CA, IE\n\nSiriLocale: Siri 区域\n忽略系统中“Siri”的“语言”设置，强制采用这里的设置。\n可选值: zh_CN, OFF, AUTO, zh_TW, yue_CN, zh_HK, ja_JP, en_CA, en_SG, en_AU, en_IE, en_US, en_GB, ko_KR\n\nRegion: 区域\n作用未知，待测试。\n可选值: OFF, AUTO, CN, HK, TW, SG, US, JP, AU, GB, KR, CA, IE\n\nSiriResponseLanguageVariant: Siri 响应语言修改\n自定义 Siri 回复时使用的语言。\n可选值: zh_CN, OFF, AUTO, zh_TW, yue_CN, zh_HK, ja_JP, en_CA, en_SG, en_AU, en_IE, en_US, en_GB, ko_KR\n\nLogLevel: [调试] 日志等级\n选择脚本日志的输出等级，低于所选等级的日志将全部输出。\n可选值: WARN, OFF, ERROR, INFO, DEBUG, ALL

[Script]
⭕ Siri.Search.request = type=http-request, engine=auto, pattern=^https?:\/\/(api-siri|api2|api-.+)\.smoot\.apple\.com\/search, script-path=https://github.com/NSRingo/Siri/releases/download/v4.2.7/request.bundle.js, argument=CountryCode="{{{CountryCode}}}"&amp;SiriLocale="{{{SiriLocale}}}"&amp;Region="{{{Region}}}"&amp;SiriResponseLanguageVariant="{{{SiriResponseLanguageVariant}}}"&amp;LogLevel="{{{LogLevel}}}"

⭕ Siri.SiriSearch.request = type=http-request, engine=auto, pattern=^https?:\/\/(guzzoni|api2|api-.+)\.smoot\.apple\.com\/apple\.parsec\.siri\.v2alpha\.SiriSearch\/SiriSearch, script-path=https://github.com/NSRingo/Siri/releases/download/v4.2.7/request.bundle.js, requires-body=true, binary-body-mode=true, argument=CountryCode="{{{CountryCode}}}"&amp;SiriLocale="{{{SiriLocale}}}"&amp;Region="{{{Region}}}"&amp;SiriResponseLanguageVariant="{{{SiriResponseLanguageVariant}}}"&amp;LogLevel="{{{LogLevel}}}"

🔍 Safari.SafariSearch.request = type=http-request, engine=auto, pattern=^https?:\/\/api-safari(-.+)?\.smoot\.apple\.com\/apple\.parsec\.safari\.v1alpha\.SafariSearch\/SafariSearch, script-path=https://github.com/NSRingo/Siri/releases/download/v4.2.7/request.bundle.js, requires-body=true, binary-body-mode=true, argument=CountryCode="{{{CountryCode}}}"&amp;SiriLocale="{{{SiriLocale}}}"&amp;Region="{{{Region}}}"&amp;SiriResponseLanguageVariant="{{{SiriResponseLanguageVariant}}}"&amp;LogLevel="{{{LogLevel}}}"

🔍 Lookup.LookupSearch.request = type=http-request, engine=auto, pattern=^https?:\/\/api-lookup(-.+)?\.smoot\.apple\.com\/apple\.parsec\.lookup\.v1alpha\.LookupSearch\/LookupSearch, script-path=https://github.com/NSRingo/Siri/releases/download/v4.2.7/request.bundle.js, requires-body=true, binary-body-mode=true, argument=CountryCode="{{{CountryCode}}}"&amp;SiriLocale="{{{SiriLocale}}}"&amp;Region="{{{Region}}}"&amp;SiriResponseLanguageVariant="{{{SiriResponseLanguageVariant}}}"&amp;LogLevel="{{{LogLevel}}}"

🔍 Visualsearch.VisualSearch.request = type=http-request, engine=auto, pattern=^https?:\/\/(api2|api-.+)\.smoot\.apple\.com\/apple\.parsec\.visualsearch\.v2\.VisualSearch\/VisualSearch, script-path=https://github.com/NSRingo/Siri/releases/download/v4.2.7/request.bundle.js, requires-body=true, binary-body-mode=true, argument=CountryCode="{{{CountryCode}}}"&amp;SiriLocale="{{{SiriLocale}}}"&amp;Region="{{{Region}}}"&amp;SiriResponseLanguageVariant="{{{SiriResponseLanguageVariant}}}"&amp;LogLevel="{{{LogLevel}}}"

🔍 ResponseFramework.Engagement.EngagementSearch.request = type=http-request, engine=auto, pattern=^https?:\/\/(api-.+)\.smoot\.apple\.com\/apple\.parsec\.responseframework\.engagement\.v1alpha\.EngagementSearch\/EngagementSearch, script-path=https://github.com/NSRingo/Siri/releases/download/v4.2.7/request.bundle.js, requires-body=true, binary-body-mode=true, argument=CountryCode="{{{CountryCode}}}"&amp;SiriLocale="{{{SiriLocale}}}"&amp;Region="{{{Region}}}"&amp;SiriResponseLanguageVariant="{{{SiriResponseLanguageVariant}}}"&amp;LogLevel="{{{LogLevel}}}"

🔍 Spotlight.ZkwSuggestService.request = type=http-request, engine=auto, pattern=^https?:\/\/(api-.+)\.smoot\.apple\.com\/apple\.parsec\.spotlight\.v1alpha\.ZkwSuggestService\/Suggest, script-path=https://github.com/NSRingo/Siri/releases/download/v4.2.7/request.bundle.js, requires-body=true, binary-body-mode=true, argument=CountryCode="{{{CountryCode}}}"&amp;SiriLocale="{{{SiriLocale}}}"&amp;Region="{{{Region}}}"&amp;SiriResponseLanguageVariant="{{{SiriResponseLanguageVariant}}}"&amp;LogLevel="{{{LogLevel}}}"

[MITM]
hostname = %APPEND% guzzoni.smoot.apple.com, api2.smoot.apple.com, api-*.smoot.apple.com
